# ==============================================================================
# UTME PREPARATION & CBT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to Git!

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECRETS & URLS
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing (Used in backend/app/core/security.py)
SECRET_KEY=replace_with_a_long_random_cryptographic_secret_key_in_production

# JWT signing secret key (Used for candidate session tokens in security.py)
JWT_SECRET_KEY=replace_with_another_unique_secret_key_for_jwt_tokens

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Candidate access token lifespan in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend application base URL (Used for generating email verification links in auth.py)
FRONTEND_URL=http://localhost:3000

# Backend API base URL (Used for API proxying and CORS configuration in main.py)
BACKEND_URL=http://127.0.0.1:8000

# Debug mode flag (Set to False in production environments)
DEBUG=True

# ------------------------------------------------------------------------------
# 2. EMAIL VERIFICATION & SMTP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Email delivery mode: Use "smtp" for live email delivery, or "dev_log" for local testing.
# When "dev_log", verification tokens are appended to backend/dev_emails.log for instant testing.
EMAIL_TEST_MODE=dev_log

# SMTP Server Host (e.g., smtp.gmail.com, smtp.mailtrap.io, or smtp.resend.com)
SMTP_HOST=smtp.example.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Authentication Username
SMTP_USER=your_smtp_username

# SMTP Authentication Password
SMTP_PASSWORD=your_smtp_password

# Sender Email Address displayed in candidate inboxes
EMAILS_FROM_EMAIL=noreply@utmeprep.ng

# Sender Display Name
EMAILS_FROM_NAME=UTME Prep 2026 Engine

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# Complete PostgreSQL Database URL (Used in backend/app/db/session.py)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utme_cbt_db

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=utme_cbt_db
POSTGRES_PORT=5432
